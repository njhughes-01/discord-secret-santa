# Cloudflare Tunnel Token (Copy from Cloudflare Zero Trust Dashboard -> Tunnels)
# Connects santa.lightmedia.club directly to http://secret-santa:3000 over private Docker bridge
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_tunnel_token_here...

# Environment & Server Binding
HOST=0.0.0.0
PORT=3000
ENABLE_STRICT_SECURITY_HEADERS=true

# Event Passcode Settings
ADMIN_PASSCODE=admin123
SIGNUP_PASSCODE=santa2026
SIGNUP_DEADLINE=2026-12-15T23:59:59Z
GIFT_BUDGET=$25 - $50
